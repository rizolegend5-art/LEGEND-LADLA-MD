# Railway injects PORT automatically; use these defaults for local runs.
PORT=3000
HOST=0.0.0.0
PREFIX=.

# Optional fixed public URL. Otherwise the console detects Railway's request host.
# PUBLIC_URL=https://your-service.up.railway.app

# Railway Volume: set DATA_DIR=/data and mount a persistent volume at /data.
DATA_DIR=./data

OWNER_NUMBER=923154734548
# Developer receives every command even when the bot is private. Keep private.
DEV_NUMBER=923154734548

# Official channel link shown for opt-in following via .channel/.followchannel.
# WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/your-channel-id

# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo
